{% extends "html/admin/page/template.html.twig" %}
{% block main %}
    {% autoescape false %}
    <div class="p-4 bg-white border border-gray-200 rounded-lg shadow-xs">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">
                {{ "Activities"|trans }}
            </h3>
            <a href="{{ relativeUrl('admin/activities/export') }}" class="btn--primary">
                {{ "Export to Excel"|trans }}
            </a>
        </div>
        <div class="relative overflow-x-auto">
            <table class="data-table" id="activities-table">
                <thead>
                <tr>
                    <th scope="col">{{ "Date"|trans }}</th>
                    <th scope="col">{{ "Name"|trans }}</th>
                    <th scope="col">{{ "Sport type"|trans }}</th>
                    <th scope="col">{{ "Distance"|trans }}</th>
                    <th scope="col">{{ "Elevation"|trans }}</th>
                    <th scope="col">{{ "Gear"|trans }}</th>
                    <th scope="col">{{ "Commute"|trans }}</th>
                    <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                {% for activity in activities %}
                    {% set activityId = activity.getId() %}
                    {% set isEdited = ('' ~ activityId) in overriddenActivityIds %}
                    <tr class="group/row">
                        <td class="narrow whitespace-nowrap">{{ activity.getStartDate()|formatDate() }}</td>
                        <td>
                            {{ activity.getName() }}
                            {% if isEdited %}
                                <span class="ml-1 text-xs rounded-full bg-amber-100 text-amber-700 px-2 py-0.5">{{ "edited"|trans }}</span>
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap">{{ activity.getSportType()|trans }}</td>
                        <td class="whitespace-nowrap">{{ activity.getDistance()|convertMeasurement|renderMeasurement(1) }}</td>
                        <td class="whitespace-nowrap">{{ activity.getElevation()|convertMeasurement|renderMeasurement(0) }}</td>
                        <td class="whitespace-nowrap">{{ activity.getGearName() ?? '' }}</td>
                        <td class="whitespace-nowrap">{{ activity.isCommute() ? "Yes"|trans : "No"|trans }}</td>
                        <td class="whitespace-nowrap">
                            <button type="button" class="btn--secondary"
                                    data-activity-edit-open
                                    data-activity-id="{{ activityId }}"
                                    data-name="{{ activity.getOriginalName()|e('html_attr') }}"
                                    data-description="{{ activity.getDescription()|e('html_attr') }}"
                                    data-sport-type="{{ activity.getSportType().value }}"
                                    data-distance="{{ activity.getDistance().toFloat() }}"
                                    data-elevation="{{ activity.getElevation().toFloat() }}"
                                    data-gear-id="{{ activity.getGearId() ?? '' }}"
                                    data-is-commute="{{ activity.isCommute() ? '1' : '0' }}">
                                {{ "Edit"|trans }}
                            </button>
                            {% if isEdited %}
                                <button type="button" class="btn--secondary" data-activity-revert data-activity-id="{{ activityId }}">
                                    {{ "Revert"|trans }}
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                {% if activities.isEmpty() %}
                    <tr>
                        <td colspan="8">
                            <div class="flex flex-col items-center justify-center gap-3 py-12 px-4 text-center">
                                <span class="text-sm font-medium text-gray-800">{{ "No activities found."|trans }}</span>
                            </div>
                        </td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <div id="activity-edit-modal" tabindex="-1" aria-hidden="true" class="hidden fixed top-0 left-0 right-0 z-50 w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative w-full max-w-lg max-h-full mx-auto mt-20">
            <div class="relative bg-white rounded-lg shadow">
                <div class="flex items-center justify-between p-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold">{{ "Edit activity"|trans }}</h3>
                    <button type="button" data-modal-hide="activity-edit-modal" class="text-gray-400 hover:text-gray-900">&times;</button>
                </div>
                <form id="activity-edit-form" class="p-4 space-y-4">
                    <input type="hidden" name="activityId">
                    <div>
                        <label>{{ "Name"|trans }}</label>
                        <input type="text" name="name" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                    </div>
                    <div>
                        <label>{{ "Description"|trans }}</label>
                        <textarea name="description" rows="3" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5"></textarea>
                    </div>
                    <div>
                        <label>{{ "Sport type"|trans }}</label>
                        <select name="sportType" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                            {% for sportType in sportTypes %}
                                <option value="{{ sportType.value }}">{{ sportType|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label>{{ "Distance (km)"|trans }}</label>
                            <input type="number" step="0.001" min="0" name="distance" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                        </div>
                        <div>
                            <label>{{ "Elevation (m)"|trans }}</label>
                            <input type="number" step="1" min="0" name="elevation" required class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                        </div>
                    </div>
                    <div>
                        <label>{{ "Gear"|trans }}</label>
                        <select name="gearId" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg block w-full p-2.5">
                            <option value="">{{ "Use Strava's gear"|trans }}</option>
                            {% for gear in gears %}
                                <option value="{{ gear.getId() }}">{{ gear.getName() }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="isCommute" id="activity-edit-is-commute">
                        <label for="activity-edit-is-commute">{{ "Commute"|trans }}</label>
                    </div>
                    <div class="flex justify-end gap-2 pt-2">
                        <button type="button" data-modal-hide="activity-edit-modal" class="btn--secondary">{{ "Cancel"|trans }}</button>
                        <button type="submit" class="btn--primary">{{ "Save"|trans }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% endautoescape %}
{% endblock main %}
